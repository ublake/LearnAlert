        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos encantará conocer tus ideas, comentarios y cualquier problema que encuentres. Tus aportes influyen directamente en las próximas actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
