          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez entre 3 et 24 caractères. Commencez par une lettre et utilisez uniquement des lettres, des chiffres, des tirets bas ou des tirets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3〜24文字で入力してください。文字で始め、文字、数字、アンダースコア、ハイフンだけを使ってください。"
