    "Use 3–24 characters, starting with a letter. Letters from any language and digits are allowed. Use single hyphens or underscores between parts." : {
      "comment" : "Interface copy. LearnAlert/Features/Community/CommunityProfile.swift",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende 3–24 Zeichen und beginne mit einem Buchstaben. Buchstaben aus jeder Sprache und Ziffern sind erlaubt. Trenne die Teile durch einzelne Binde- oder Unterstriche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa entre 3 y 24 caracteres y empieza con una letra. Puedes usar letras de cualquier idioma y dígitos. Separa las partes con un solo guion o guion bajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez entre 3 et 24 caractères et commencez par une lettre. Les lettres de toutes les langues et les chiffres sont autorisés. Séparez les parties par un seul tiret ou tiret bas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3〜24文字で、最初は文字にしてください。どの言語の文字や数字も使えます。区切りにはハイフンまたはアンダースコアを1つ使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3~24자로 입력하고 문자로 시작하세요. 모든 언어의 문자와 숫자를 사용할 수 있어요. 각 부분은 하이픈이나 밑줄 하나로 구분하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use de 3 a 24 caracteres e comece com uma letra. São permitidos dígitos e letras de qualquer idioma. Separe as partes com um único hífen ou sublinhado."
          }
        }
      }
    },
    "Use 3–24 characters. Start with a letter and use only letters, numbers, underscores, or hyphens." : {
      "comment" : "Interface copy. LearnAlert/Features/Community/CommunityAPI.swift",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende 3–24 Zeichen. Beginne mit einem Buchstaben und verwende nur Buchstaben, Ziffern, Unterstriche oder Bindestriche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
