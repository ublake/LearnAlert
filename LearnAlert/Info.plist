<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Anki Deck Package</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array><string>net.ankiweb.apkg</string></array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.ankiweb.apkg</string>
			<key>UTTypeDescription</key>
			<string>Anki Deck Package</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>apkg</string></array>
				<key>public.mime-type</key>
				<string>application/x-anki</string>
			</dict>
		</dict>
	</array>
	<key>APIKey</key>
	<string>$(API_KEY)</string>
	<key>DebugToken</key>
	<string>$(DEBUG_TOKEN)</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.5</string>
	<key>TikTokTrackingEnabled</key>
	<string>$(TIKTOK_TRACKING_ENABLED)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Poppins-Regular.ttf</string>
		<string>Poppins-SemiBold.ttf</string>
	</array>
</dict>
</plist>
