    },
    "Tap to listen. These previews don’t change your current sounds. Silent mode and volume apply.": {
      "comment": "Interface copy. LearnAlert/SoundPreviewGallery.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para escuchar. Estas muestras no cambian tus sonidos actuales. Se respetan el modo silencio y el volumen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ouvir. Estas prévias não alteram seus sons atuais. O modo silencioso e o volume são respeitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour écouter. Ces aperçus ne changent pas vos sons actuels. Le mode silencieux et le volume s’appliquent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Anhören. Diese Vorschauen ändern deine aktuellen Klänge nicht. Lautlosmodus und Lautstärke gelten weiterhin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで試聴できます。現在の音設定は変わりません。消音モードと音量設定が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 들어 보세요. 미리듣기는 현재 소리 설정을 바꾸지 않아요. 무음 모드와 음량 설정이 적용돼요."
          }
        }
      }
    },
