    "%@ Your changes weren’t saved.": {
      "comment": "Interface copy. LearnAlert/ContentView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tus cambios no se guardaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Suas alterações não foram salvas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vos modifications n’ont pas été enregistrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Deine Änderungen wurden nicht gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 変更は保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 변경 사항이 저장되지 않았어요."
          }
        }
      }
    },
    "%@ Your changes weren’t saved. Alerts couldn’t be restored; please schedule them again.": {
      "comment": "Interface copy. LearnAlert/ContentView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tus cambios no se guardaron. No se pudieron restaurar las alertas; vuelve a programarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Suas alterações não foram salvas. Não foi possível restaurar os alertas; programe-os novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vos modifications n’ont pas été enregistrées. Les alertes n’ont pas pu être rétablies ; veuillez les reprogrammer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Deine Änderungen wurden nicht gespeichert. Die Erinnerungen konnten nicht wiederhergestellt werden. Bitte plane sie erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 変更は保存されませんでした。通知を復元できなかったため、もう一度設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 변경 사항이 저장되지 않았어요. 알림을 복원하지 못했으니 다시 예약해 주세요."
          }
        }
      }
    },
