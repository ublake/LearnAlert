    "Some cards reference online media or libraries. Only bundled files are available during offline study.": {
      "comment": "Interface copy. Packages/AnkiArchive/Sources/AnkiArchive/AnkiTemplateRenderer.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas tarjetas hacen referencia a multimedia o bibliotecas en línea. Solo los archivos incluidos estarán disponibles al estudiar sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns cartões fazem referência a mídias ou bibliotecas online. Apenas os arquivos incluídos ficam disponíveis para estudar sem conexão."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines cartes font référence à des médias ou bibliothèques en ligne. Seuls les fichiers inclus sont disponibles hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Karten verweisen auf Online-Medien oder Bibliotheken. Beim Offline-Lernen sind nur enthaltene Dateien verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のカードはオンラインのメディアやライブラリを参照しています。オフラインでは同梱ファイルのみ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 카드는 온라인 미디어나 라이브러리를 참조해요. 오프라인 학습 중에는 패키지에 포함된 파일만 사용할 수 있어요."
          }
        }
      }
    },
