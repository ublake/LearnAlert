    "Matching cards need at least two complete text, image or audio pairs.": {
      "comment": "Interface copy. LearnAlert/CommunityAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de parejas necesitan al menos dos parejas completas de texto, imagen o audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões de pares precisam de pelo menos dois pares completos de texto, imagem ou áudio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes d’association nécessitent au moins deux paires complètes de texte, image ou audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuordnungskarten benötigen mindestens zwei vollständige Text-, Bild- oder Audiopaare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッチングには、テキスト・画像・音声で完成したペアが2組以上必要です。"
