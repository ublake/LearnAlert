    "Swipe a deck left and tap Alerts to switch your active alert deck anytime.": {
      "comment": "Interface copy. LearnAlert/ContentView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un mazo a la izquierda y toca Alertas para cambiar el mazo activo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um baralho para a esquerda e toque em Alertas para trocar o baralho ativo quando quiser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez un paquet vers la gauche et touchez Alertes pour changer de paquet actif à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische einen Stapel nach links und tippe auf Erinnerungen, um deinen aktiven Erinnerungsstapel jederzeit zu wechseln."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキを左にスワイプして「通知」をタップすると、通知するデッキをいつでも切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덱을 왼쪽으로 쓸어넘겨 알림을 누르면 활성 알림 덱을 언제든 바꿀 수 있어요."
          }
        }
      }
    },
    "Swipe down from the top to find the alert. Swipe left on it, then tap View. This works in the simulator, too.": {
      "comment": "Interface copy. LearnAlert/NotificationTestGuideView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza desde arriba para encontrar la alerta. Deslízala a la izquierda y toca Ver. También funciona en el simulador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize de cima para baixo para encontrar o alerta. Deslize-o para a esquerda e toque em Ver. Também funciona no simulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez depuis le haut pour trouver l’alerte. Glissez-la vers la gauche, puis touchez Afficher. Cela fonctionne aussi dans le simulateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische vom oberen Rand nach unten, um die Erinnerung zu finden. Wische sie nach links und tippe auf Anzeigen. Das funktioniert auch im Simulator."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上から下にスワイプして通知を探し、左にスワイプして「表示」をタップします。シミュレータでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 위에서 아래로 쓸어내려 알림을 찾으세요. 알림을 왼쪽으로 쓸어넘겨 보기를 누르세요. 시뮬레이터에서도 가능해요."
          }
        }
      }
    },
    "Swipe left on answer choices to add images or audio files.": {
      "comment": "Interface copy. LearnAlert/CreateCardView.swift",
      "localizations": {
