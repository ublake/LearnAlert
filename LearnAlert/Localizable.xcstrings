    "No compatible cards were found in this package. It may be empty or use unsupported note types.": {
      "comment": "Interface copy. Packages/AnkiArchive/Sources/AnkiArchive/AnkiPackageReader.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron tarjetas compatibles en este paquete. Puede estar vacío o usar tipos de nota no compatibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum cartão compatível foi encontrado neste pacote. Ele pode estar vazio ou usar tipos de nota incompatíveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune carte compatible dans ce paquet. Il est peut-être vide ou utilise des types de notes non pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Paket wurden keine kompatiblen Karten gefunden. Es ist möglicherweise leer oder verwendet nicht unterstützte Notiztypen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するカードが見つかりませんでした。パッケージが空か、未対応のノートタイプが使われている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
