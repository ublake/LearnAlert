    "Deletion actions require confirmation and can’t be undone.": {
      "comment": "Interface copy. LearnAlert/SettingsSections.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las eliminaciones requieren confirmación y no se pueden deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exclusões exigem confirmação e não podem ser desfeitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppressions nécessitent une confirmation et sont irréversibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschaktionen erfordern eine Bestätigung und können nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除には確認が必要です。一度削除すると元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하려면 확인이 필요하며, 삭제 후 되돌릴 수 없어요."
          }
        }
      }
    },
    "Deletion could not finish. Your library will show what remains. Please try again.": {
      "comment": "Interface copy. LearnAlert/SettingsSections.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la eliminación. Tu biblioteca mostrará lo que queda. Vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a exclusão. Sua biblioteca mostrará o que resta. Tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n’a pas pu aboutir. Votre bibliothèque affichera les éléments restants. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen konnte nicht abgeschlossen werden. Deine Bibliothek zeigt die verbleibenden Inhalte. Bitte versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を完了できませんでした。残った項目はライブラリに表示されます。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 완료하지 못했어요. 남은 항목은 라이브러리에 표시돼요. 다시 시도해 주세요."
          }
        }
      }
    },
