    "LearnAlert is running in temporary memory mode. Flashcards may not persist between app launches.": {
      "comment": "Interface copy. LearnAlert/SharedDatabase.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert está funcionando en modo de memoria temporal. Es posible que las tarjetas no se conserven al volver a abrir la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LearnAlert está usando memória temporária. Os cartões podem não ser mantidos ao reabrir o app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert utilise une mémoire temporaire. Les fiches risquent de ne pas être conservées entre les lancements de l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert verwendet vorübergehenden Speicher. Lernkarten bleiben möglicherweise zwischen App-Starts nicht erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlertは一時メモリで動作しています。アプリを開き直すとカードが保持されない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert가 임시 메모리 모드로 실행 중이에요. 앱을 다시 열면 플래시카드가 유지되지 않을 수 있어요."
          }
        }
      }
    },
    "LearnAlert needs notification permissions to send you flashcard alerts. Please allow Notifications in your iPhone Settings.": {
      "comment": "Interface copy. LearnAlert/HelpView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert necesita permiso para enviarte alertas con tarjetas. Permite las notificaciones en los ajustes de tu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LearnAlert precisa de permissão para enviar alertas com cartões. Permita notificações nos Ajustes do seu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert a besoin de l’autorisation d’envoyer des notifications pour vos fiches. Autorisez les notifications dans les réglages de votre iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert benötigt die Erlaubnis für Benachrichtigungen, um Lernkartenerinnerungen zu senden. Erlaube Mitteilungen in deinen iPhone-Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードの通知を送るには通知の許可が必要です。iPhoneの設定でLearnAlertの通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플래시카드 알림을 보내려면 알림 권한이 필요해요. iPhone 설정에서 LearnAlert의 알림을 허용해 주세요."
          }
        }
      }
    },
    "LearnAlert uses artificial intelligence to generate flashcards and summarize your study materials.": {
      "comment": "Interface copy. LearnAlert/AIConsentSheet.swift",
      "localizations": {
        "es": {
          "stringUnit": {
