    "Thank you for your feedback! It helps us improve LearnAlert.": {
      "comment": "Interface copy. LearnAlert/SettingsSections.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por tus comentarios! Nos ayudan a mejorar LearnAlert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado pelo feedback! Ele nos ajuda a melhorar o LearnAlert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour votre commentaire ! Il nous aide à améliorer LearnAlert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für dein Feedback! Es hilft uns, LearnAlert zu verbessern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見ありがとうございます！LearnAlertの改善に役立てます。"
