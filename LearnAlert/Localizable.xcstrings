    "Use the same Apple account to finish deleting your community profile and submissions. Your personal library stays on this device.": {
      "comment": "Interface copy. LearnAlert/CommunityProfile.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
