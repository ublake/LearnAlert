    "Share a deck you created. Built-in and downloaded community decks can’t be republished.": {
      "comment": "Interface copy. LearnAlert/CommunityAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un mazo que hayas creado. Los mazos incluidos en la app y los descargados de la comunidad no se pueden volver a publicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe um baralho criado por você. Baralhos incluídos no app e baixados da comunidade não podem ser republicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez un paquet que vous avez créé. Les paquets intégrés et ceux téléchargés depuis la communauté ne peuvent pas être republiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen selbst erstellten Stapel. Integrierte und aus der Community heruntergeladene Stapel können nicht erneut veröffentlicht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で作ったデッキを共有しましょう。内蔵デッキやダウンロードしたコミュニティデッキは再公開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 덱을 공유하세요. 기본 제공 덱과 다운로드한 커뮤니티 덱은 다시 게시할 수 없어요."
          }
        }
      }
    },
    "Share a deck you created. Built-in and downloaded shared decks can’t be republished.": {
      "comment": "Interface copy. LearnAlert/CommunityViews.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
