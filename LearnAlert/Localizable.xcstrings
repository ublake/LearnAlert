                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vous avez atteint la limite quotidienne de %lld envois de documents et d’images. Vous pouvez toujours coller des notes ou du texte (jusqu’à 10 000 caractères) pour créer des paquets sans limite !"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
