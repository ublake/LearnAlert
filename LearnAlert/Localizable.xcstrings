    "The AI response was received with HTTP 200 OK, but could not be parsed into the expected deck schema.": {
      "comment": "Interface copy. LearnAlert/LearnAlertAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recibió la respuesta de IA con HTTP 200 OK, pero no se pudo interpretar según el esquema de mazo esperado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta da IA foi recebida com HTTP 200 OK, mas não pôde ser interpretada no esquema de baralho esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse IA a été reçue avec HTTP 200 OK, mais n’a pas pu être interprétée selon le schéma de paquet attendu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
