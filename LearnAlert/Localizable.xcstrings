    "On iPhone, touch and hold the notification until the question opens. Answer right there.": {
      "comment": "Interface copy. LearnAlert/NotificationTestGuideView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone, mantén pulsada la notificación hasta que se abra la pregunta. Responde ahí mismo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone, toque e segure a notificação até a pergunta abrir. Responda ali mesmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone, maintenez la notification jusqu’à ce que la question s’ouvre. Répondez directement ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte auf dem iPhone die Benachrichtigung gedrückt, bis sich die Frage öffnet. Antworte direkt dort."
          }
        },
        "ja": {
          "stringUnit": {
