    "Image cards need a front image, an optional back image, and no question, answer, hint, choices, matching pairs, or audio.": {
      "comment": "Interface copy. LearnAlert/CommunityAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de imágenes necesitan una imagen del anverso, una opcional del reverso y ningún texto de pregunta, respuesta, pista, opciones, parejas ni audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartões de imagens precisam de uma imagem da frente, uma opcional do verso e nenhum texto de pergunta, resposta, dica, opções, pares ou áudio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes d’images nécessitent une image au recto et éventuellement au verso, sans question, réponse, indice, choix, paires à associer ni audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
