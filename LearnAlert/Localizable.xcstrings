    "Ensure the PDF is not encrypted or password-protected, and has readable pages.": {
      "comment": "Interface copy. LearnAlert/GeneratedQuizImportView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el PDF no esté cifrado ni protegido con contraseña y que tenga páginas legibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o PDF não está criptografado ou protegido por senha e tem páginas legíveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le PDF n’est ni chiffré ni protégé par mot de passe et que ses pages sont lisibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass die PDF-Datei weder verschlüsselt noch passwortgeschützt ist und lesbare Seiten enthält."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFが暗号化・パスワード保護されておらず、ページを読み取れることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF가 암호화되거나 비밀번호로 보호되어 있지 않고, 페이지를 읽을 수 있는지 확인하세요."
          }
        }
      }
    },
    "Ensure the file exists in iCloud Drive or on device and is a supported PDF, TXT, or image.": {
      "comment": "Interface copy. LearnAlert/GeneratedQuizImportView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
