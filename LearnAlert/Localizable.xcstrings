          }
        }
      }
    },
    "On-device data may be removed when the app is deleted. Download your data first if you want a personal copy.": {
      "comment": "Interface copy. LearnAlert/HelpView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del dispositivo pueden eliminarse al borrar la app. Descarga tus datos antes si quieres una copia personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados no dispositivo podem ser removidos ao excluir o app. Baixe seus dados antes se quiser uma cópia pessoal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sur l’appareil peuvent être supprimées avec l’app. Téléchargez-les d’abord pour en conserver une copie personnelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten auf dem Gerät können beim Löschen der App entfernt werden. Lade sie vorher herunter, wenn du eine eigene Kopie möchtest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除すると、デバイス内のデータも削除される場合があります。コピーが必要な場合は、先にデータをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 삭제하면 기기의 데이터도 삭제될 수 있어요. 개인 사본을 보관하려면 먼저 데이터를 다운로드하세요."
          }
        }
      }
    },
    "Once created, you can add flashcards or import notes with AI. LearnAlert will automatically schedule lock-screen alerts so you study effortlessly on repeat.": {
      "comment": "Interface copy. LearnAlert/CreateDeckView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez creado, puedes añadir tarjetas o importar notas con IA. LearnAlert programará automáticamente alertas en la pantalla de bloqueo para que estudies y repases sin esfuerzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de criar, você pode adicionar cartões ou importar anotações com IA. O LearnAlert programará automaticamente alertas na tela bloqueada para você estudar e revisar sem esforço."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois le paquet créé, ajoutez des fiches ou importez des notes avec l’IA. LearnAlert programmera automatiquement des alertes sur l’écran verrouillé pour vous faire étudier régulièrement sans effort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Erstellen kannst du Lernkarten hinzufügen oder Notizen mit KI importieren. LearnAlert plant automatisch Sperrbildschirm-Erinnerungen, damit du mühelos regelmäßig lernst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成後にカードを追加したり、AIでノートを取り込めます。LearnAlertがロック画面の通知を自動設定し、繰り返し学習をサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덱을 만든 뒤 플래시카드를 추가하거나 AI로 노트를 가져올 수 있어요. LearnAlert가 잠금 화면 알림을 자동으로 예약해 편하게 반복 학습할 수 있어요."
          }
        }
      }
    },
