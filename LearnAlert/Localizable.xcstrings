          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Você atingiu o limite diário de %lld envio de documentos e imagens. Ainda pode colar anotações ou texto (até 10.000 caracteres) para criar baralhos sem limite!"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
