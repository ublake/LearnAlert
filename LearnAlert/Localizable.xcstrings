    "This permanently deletes all decks and cards from this device.": {
      "comment": "Interface copy. LearnAlert/SettingsSections.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos los mazos y tarjetas de este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente todos os baralhos e cartões deste dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tous les paquets et toutes les cartes de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Stapel und Karten dauerhaft von diesem Gerät gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの全デッキとカードを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 모든 덱과 카드를 영구 삭제해요."
          }
        }
      }
    },
    "This permanently deletes the shared submission and its cards. File removal is retried if needed. Your personal deck and other learners’ downloaded copies stay.": {
      "comment": "Interface copy. LearnAlert/CommunityViews.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente el envío compartido y sus tarjetas. La eliminación de archivos se reintenta si hace falta. Tu mazo personal y las copias descargadas por otros estudiantes se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente o envio compartilhado e seus cartões. A remoção de arquivos é repetida se necessário. Seu baralho pessoal e as cópias baixadas por outros estudantes permanecem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement la soumission partagée et ses cartes. La suppression des fichiers est réessayée si nécessaire. Votre paquet personnel et les copies téléchargées par d’autres personnes sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die geteilte Einreichung und ihre Karten dauerhaft gelöscht. Dateien werden bei Bedarf erneut zum Löschen vorgemerkt. Dein persönlicher Stapel und heruntergeladene Kopien anderer Lernender bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有した提出内容とカードを完全に削除します。ファイルの削除は必要に応じて再試行されます。個人のデッキと他の学習者のダウンロード済みコピーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유한 제출물과 카드를 영구 삭제해요. 필요하면 파일 삭제를 재시도해요. 개인 덱과 다른 학습자가 다운로드한 사본은 유지돼요."
          }
        }
      }
    },
