          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert n’a pas pu accéder au stockage permanent. Les modifications seront conservées uniquement pour cette séance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert konnte nicht auf den dauerhaften Speicher zugreifen. Änderungen bleiben nur für diese Sitzung erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存領域にアクセスできませんでした。変更内容は今回のセッション中のみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LearnAlert가 영구 저장소에 접근하지 못했어요. 변경 사항은 이번 세션에서만 유지돼요."
          }
        }
      }
    },
    "LearnAlert is loading": {
      "comment": "Interface copy. LearnAlert/LaunchLoadingView.swift",
      "localizations": {
