          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les équations utilisent le moteur KaTeX hors ligne de LearnAlert. Les macros MathJax propres à Anki et les documents LaTeX complets peuvent nécessiter des adaptations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formeln verwenden den Offline-KaTeX-Renderer von LearnAlert. Anki-spezifische MathJax-Makros und vollständige LaTeX-Dokumente müssen eventuell angepasst werden."
          }
