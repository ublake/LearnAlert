    "Alerts appear while your device is locked or on the Home Screen—not while you’re using LearnAlert.": {
      "comment": "Interface copy. LearnAlert/ContentView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas aparecen con el dispositivo bloqueado o en la pantalla de inicio, no mientras usas LearnAlert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas aparecem com o dispositivo bloqueado ou na tela de início, não enquanto você usa o LearnAlert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes apparaissent quand votre appareil est verrouillé ou sur l’écran d’accueil, pas pendant l’utilisation de LearnAlert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen erscheinen bei gesperrtem Gerät oder auf dem Home-Bildschirm, nicht während du LearnAlert verwendest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はロック画面やホーム画面に表示され、LearnAlertの使用中は表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 기기가 잠겨 있거나 홈 화면에 있을 때 표시되며, LearnAlert 사용 중에는 표시되지 않아요."
          }
        }
      }
    },
    "Alerts are currently turned off in iOS Settings. You can enable them to receive lock screen cards, or continue studying in-app.": {
      "comment": "Interface copy. LearnAlert/NotificationPermissionPromptView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas están desactivadas en los ajustes de iOS. Puedes activarlas para recibir tarjetas en la pantalla de bloqueo o seguir estudiando en la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas estão desativados nos Ajustes do iOS. Você pode ativá-los para receber cartões na tela bloqueada ou continuar estudando no app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont désactivées dans les réglages iOS. Activez-les pour recevoir des cartes sur l’écran verrouillé, ou continuez à étudier dans l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind in den iOS-Einstellungen deaktiviert. Aktiviere sie für Karten auf dem Sperrbildschirm oder lerne in der App weiter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定で通知がオフになっています。有効にするとロック画面にカードが届きます。アプリ内での学習も続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 알림이 꺼져 있어요. 켜면 잠금 화면에서 카드를 받거나, 앱에서 계속 학습할 수 있어요."
          }
        }
      }
    },
