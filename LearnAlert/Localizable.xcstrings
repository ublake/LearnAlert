    "Apple access changed. Sign in again to use your community account.": {
      "comment": "Interface copy. LearnAlert/CommunityAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de Apple cambió. Vuelve a iniciar sesión para usar tu cuenta de la comunidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso da Apple mudou. Entre novamente para usar sua conta da comunidade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Apple a changé. Reconnectez-vous pour utiliser votre compte communautaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Apple-Zugriff hat sich geändert. Melde dich erneut an, um dein Community-Konto zu nutzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのアクセス権が変更されました。コミュニティアカウントを使うには再ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 접근 권한이 변경되었어요. 커뮤니티 계정을 사용하려면 다시 로그인해 주세요."
          }
        }
      }
    },
    "Apple confirmation could not finish. Please try again.": {
      "comment": "Interface copy. LearnAlert/CommunityProfile.swift",
      "localizations": {
        "es": {
          "stringUnit": {
