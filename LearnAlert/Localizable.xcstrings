    "Vocabulary, grammar and everyday conversations. Pick a deck and learn at your own pace.": {
      "comment": "Interface copy. LearnAlert/LanguageDeckDiscoveryView.swift",
      "localizations": {
        "es": {
          "stringUnit": {
