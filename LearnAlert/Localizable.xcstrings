        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 보내 주셔서 감사해요! LearnAlert 개선에 도움이 돼요."
          }
        }
      }
    },
    "That easy! Now you can swipe or tap out of the notification to continue what you were doing.": {
      "comment": "Interface copy. LearnAlertExtension/NotificationViewController.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Así de fácil! Ahora puedes salir de la notificación deslizando o tocando fuera para seguir con lo que estabas haciendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simples assim! Agora deslize ou toque fora da notificação para continuar o que estava fazendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est aussi simple ! Vous pouvez maintenant glisser ou toucher hors de la notification pour reprendre votre activité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So einfach! Wische oder tippe jetzt außerhalb der Benachrichtigung, um mit deiner vorherigen Tätigkeit weiterzumachen."
          }
        },
        "ja": {
