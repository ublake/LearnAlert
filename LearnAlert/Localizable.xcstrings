          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le fichier existe dans iCloud Drive ou sur l’appareil et qu’il s’agit d’un PDF, TXT ou d’une image compatible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass die Datei in iCloud Drive oder auf dem Gerät vorhanden ist und ein unterstütztes PDF-, TXT- oder Bildformat hat."
