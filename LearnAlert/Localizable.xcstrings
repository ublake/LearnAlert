    "You have reached the daily limit of %lld document and image uploads. You can still paste notes or text (up to 10,000 characters) to create unlimited decks!": {
      "comment": "Interface copy. LearnAlert/GeneratedQuizImportView.swift",
      "localizations": {
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Has alcanzado el límite diario de %lld subida de documentos e imágenes. Puedes seguir pegando notas o texto (hasta 10.000 caracteres) para crear mazos sin límite."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Has alcanzado el límite diario de %lld subidas de documentos e imágenes. Puedes seguir pegando notas o texto (hasta 10.000 caracteres) para crear mazos sin límite."
                }
              }
            }
