    "The AI server encountered an error processing the request. Check your prompt or try a smaller section.": {
      "comment": "Interface copy. LearnAlert/LearnAlertAPI.swift",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de IA tuvo un error al procesar la solicitud. Revisa tu instrucción o prueba con una sección más pequeña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de IA encontrou um erro ao processar a solicitação. Revise sua instrução ou tente uma seção menor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur IA a rencontré une erreur de traitement. Vérifiez votre instruction ou essayez une section plus petite."
          }
